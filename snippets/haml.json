{
  "if": { "prefix": "if", "body": ["- if ${1:condition}", "\t$0"] },
  "if else": {
    "prefix": "ife",
    "body": ["- if ${1:condition}", "\t$2", "- else", "\t$0"]
  },
  "unless": { "prefix": "unless", "body": ["- unless ${1:condition}", "\t$0"] },
  "each": {
    "prefix": "each",
    "body": ["- ${1:collection}.each do |${2:item}|", "\t$0"]
  },
  "each with index": {
    "prefix": "eachi",
    "body": [
      "- ${1:collection}.each_with_index do |${2:item}, ${3:index}|",
      "\t$0"
    ]
  },
  "case": {
    "prefix": "case",
    "body": ["- case ${1:value}", "- when ${2:match}", "\t$3", "- else", "\t$0"]
  },
  "elsif": { "prefix": "elsif", "body": ["- elsif ${1:condition}", "\t$0"] },
  "else": { "prefix": "else", "body": ["- else", "\t$0"] },
  "when": { "prefix": "when", "body": ["- when ${1:value}", "\t$0"] },
  "doctype": { "prefix": "!!!", "body": ["!!! 5"] },
  "div class": { "prefix": "div", "body": [".${1:class}", "\t$0"] },
  "tag with attrs": {
    "prefix": "tag",
    "body": ["%${1:div}{${2:class: \"${3}\"}} $0"]
  },
  "render partial": {
    "prefix": "render",
    "body": ["= render \"${1:partial}\"${2:, ${3:local}: ${4:value}}"]
  },
  "render collection": {
    "prefix": "renderc",
    "body": ["= render partial: \"${1:item}\", collection: ${2:@items}"]
  },
  "render component": {
    "prefix": "rendercomp",
    "body": ["= render ${1:Name}Component.new(${2:attr}: ${3:value})"]
  },
  "render component with slots": {
    "prefix": "rendercompb",
    "body": [
      "= render ${1:Name}Component.new(${2:attr}: ${3:value}) do |${4:component}|",
      "\t- ${4:component}.with_${5:header} do",
      "\t\t$0"
    ]
  },
  "component slot": {
    "prefix": "slot",
    "body": ["- ${1:component}.with_${2:item} do", "\t$0"]
  },
  "component content": { "prefix": "content", "body": ["= content"] },
  "component slot predicate": {
    "prefix": "slot?",
    "body": ["- if ${1:header}?", "\t= ${1:header}"]
  },
  "link_to": {
    "prefix": "link_to",
    "body": ["= link_to \"${1:text}\", ${2:path}${3:, class: \"${4}\"}"]
  },
  "link_to block": {
    "prefix": "link_tob",
    "body": ["= link_to ${1:path}${2:, class: \"${3}\"} do", "\t$0"]
  },
  "button_to": {
    "prefix": "button_to",
    "body": ["= button_to \"${1:text}\", ${2:path}, method: :${3:delete}"]
  },
  "image_tag": {
    "prefix": "image_tag",
    "body": ["= image_tag \"${1:file.png}\", alt: \"${2}\""]
  },
  "form_with": {
    "prefix": "form_with",
    "body": ["= form_with model: ${1:@record} do |f|", "\t$0"]
  },
  "form field": {
    "prefix": "ff",
    "body": [
      "= f.${1|text_field,email_field,password_field,number_field,text_area,check_box,select,hidden_field,file_field,date_field|} :${2:attribute}${3:, class: \"${4}\"}"
    ]
  },
  "form label + field": {
    "prefix": "flf",
    "body": [
      "= f.label :${1:attribute}",
      "= f.${2|text_field,email_field,password_field,text_area,check_box,select|} :${1:attribute}$0"
    ]
  },
  "form submit": {
    "prefix": "fsubmit",
    "body": ["= f.submit \"${1:Save}\"${2:, class: \"${3}\"}"]
  },
  "fields_for": {
    "prefix": "fields_for",
    "body": ["= f.fields_for :${1:association} do |${2:ff}|", "\t$0"]
  },
  "content_for": {
    "prefix": "content_for",
    "body": ["- content_for :${1:name} do", "\t$0"]
  },
  "yield": { "prefix": "yield", "body": ["= yield${1: :${2:name}}"] },
  "turbo_frame_tag": {
    "prefix": "turbo_frame",
    "body": ["= turbo_frame_tag ${1:dom_id(@record)} do", "\t$0"]
  },
  "turbo_stream.append": {
    "prefix": "ts-append",
    "body": ["= turbo_stream.append ${1:dom_id(@record)} do", "\t$0"],
    "description": "For .turbo_stream.haml"
  },
  "turbo_stream.prepend": {
    "prefix": "ts-prepend",
    "body": ["= turbo_stream.prepend ${1:dom_id(@record)} do", "\t$0"],
    "description": "For .turbo_stream.haml"
  },
  "turbo_stream.replace": {
    "prefix": "ts-replace",
    "body": ["= turbo_stream.replace ${1:dom_id(@record)} do", "\t$0"],
    "description": "For .turbo_stream.haml"
  },
  "turbo_stream.update": {
    "prefix": "ts-update",
    "body": ["= turbo_stream.update ${1:dom_id(@record)} do", "\t$0"],
    "description": "For .turbo_stream.haml"
  },
  "turbo_stream.before": {
    "prefix": "ts-before",
    "body": ["= turbo_stream.before ${1:dom_id(@record)} do", "\t$0"],
    "description": "For .turbo_stream.haml"
  },
  "turbo_stream.after": {
    "prefix": "ts-after",
    "body": ["= turbo_stream.after ${1:dom_id(@record)} do", "\t$0"],
    "description": "For .turbo_stream.haml"
  },
  "turbo_stream.remove": {
    "prefix": "ts-remove",
    "body": ["= turbo_stream.remove ${1:dom_id(@record)}"],
    "description": "For .turbo_stream.haml"
  },
  "stimulus controller": {
    "prefix": "stimulus",
    "body": [".${1:wrapper}{data: {controller: \"${2:name}\"}}", "\t$0"]
  },
  "t translation": { "prefix": "t", "body": ["= t(\".${1:key}\")"] },
  "flash": {
    "prefix": "flash",
    "body": [
      "- flash.each do |type, message|",
      "\t%div{class: \"flash flash-#{type}\"}= message"
    ]
  },
  "errors": {
    "prefix": "errors",
    "body": [
      "- if ${1:@record}.errors.any?",
      "\t.errors",
      "\t\t%ul",
      "\t\t\t- ${1:@record}.errors.full_messages.each do |msg|",
      "\t\t\t\t%li= msg"
    ]
  },
  "javascript filter": { "prefix": "js", "body": [":javascript", "\t$0"] },
  "css filter": { "prefix": "css", "body": [":css", "\t$0"] },
  "ruby filter": { "prefix": "ruby", "body": [":ruby", "\t$0"] },
  "markdown filter": { "prefix": "md", "body": [":markdown", "\t$0"] },
  "plain filter": { "prefix": "plain", "body": [":plain", "\t$0"] },
  "erb filter": { "prefix": "erb", "body": [":erb", "\t$0"] },
  "scss filter": { "prefix": "scss", "body": [":scss", "\t$0"] },
  "preserve filter": { "prefix": "preserve", "body": [":preserve", "\t$0"] },
  "succeed": {
    "prefix": "succeed",
    "body": ["= succeed \"${1:.}\" do", "\t$0"]
  },
  "precede": {
    "prefix": "precede",
    "body": ["= precede \"${1:*}\" do", "\t$0"]
  },
  "surround": {
    "prefix": "surround",
    "body": ["= surround \"${1:(}\", \"${2:)}\" do", "\t$0"]
  },
  "silent comment": { "prefix": "-#", "body": ["-# $0"] },
  "strict locals": {
    "prefix": "locals",
    "body": ["-# locals: (${1:name}:${2:, ${3:option}: ${4:nil}})$0"],
    "description": "-# locals: (...)"
  },
  "layout skeleton": {
    "prefix": "layout",
    "body": [
      "!!! 5",
      "%html{lang: \"${1:en}\"}",
      "\t%head",
      "\t\t%meta{charset: \"utf-8\"}",
      "\t\t%meta{name: \"viewport\", content: \"width=device-width,initial-scale=1\"}",
      "\t\t%title= content_for(:title) || \"${2:App}\"",
      "\t\t= csrf_meta_tags",
      "\t\t= csp_meta_tag",
      "\t\t= stylesheet_link_tag \"application\", \"data-turbo-track\": \"reload\"",
      "\t\t= javascript_importmap_tags",
      "\t%body",
      "\t\t= yield"
    ]
  }
}
