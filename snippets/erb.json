{
  "ERB output tag": { "prefix": "pe", "body": ["<%= $1 %>$0"], "description": "<%= %>" },
  "ERB code tag": { "prefix": "pc", "body": ["<% $1 %>$0"], "description": "<% %>" },
  "ERB comment": { "prefix": "pcc", "body": ["<%# $1 %>$0"], "description": "<%# %>" },
  "if": { "prefix": "if", "body": ["<% if ${1:condition} %>", "\t$0", "<% end %>"] },
  "if else": { "prefix": "ife", "body": ["<% if ${1:condition} %>", "\t$2", "<% else %>", "\t$0", "<% end %>"] },
  "unless": { "prefix": "unless", "body": ["<% unless ${1:condition} %>", "\t$0", "<% end %>"] },
  "each": { "prefix": "each", "body": ["<% ${1:collection}.each do |${2:item}| %>", "\t$0", "<% end %>"] },
  "each with index": { "prefix": "eachi", "body": ["<% ${1:collection}.each_with_index do |${2:item}, ${3:index}| %>", "\t$0", "<% end %>"] },
  "case": { "prefix": "case", "body": ["<% case ${1:value} %>", "<% when ${2:match} %>", "\t$3", "<% else %>", "\t$0", "<% end %>"] },
  "render partial": { "prefix": "render", "body": ["<%= render \"${1:partial}\"${2:, ${3:local}: ${4:value}} %>"] },
  "render collection": { "prefix": "renderc", "body": ["<%= render partial: \"${1:item}\", collection: ${2:@items}${3:, as: :${4:item}} %>"] },
  "render component": { "prefix": "rendercomp", "body": ["<%= render ${1:Name}Component.new(${2:attr}: ${3:value}) %>"] },
  "link_to": { "prefix": "link_to", "body": ["<%= link_to \"${1:text}\", ${2:path}${3:, class: \"${4}\"} %>"] },
  "link_to block": { "prefix": "link_tob", "body": ["<%= link_to ${1:path}${2:, class: \"${3}\"} do %>", "\t$0", "<% end %>"] },
  "button_to": { "prefix": "button_to", "body": ["<%= button_to \"${1:text}\", ${2:path}, method: :${3:delete}${4:, data: { turbo_confirm: \"${5:Are you sure?}\" }} %>"] },
  "image_tag": { "prefix": "image_tag", "body": ["<%= image_tag \"${1:file.png}\", alt: \"${2}\"${3:, class: \"${4}\"} %>"] },
  "form_with model": { "prefix": "form_with", "body": ["<%= form_with model: ${1:@record}${2:, class: \"${3}\"} do |f| %>", "\t$0", "<% end %>"] },
  "form_with url": { "prefix": "form_with_url", "body": ["<%= form_with url: ${1:path}, method: :${2:post} do |f| %>", "\t$0", "<% end %>"] },
  "form field": { "prefix": "ff", "body": ["<%= f.${1|text_field,email_field,password_field,number_field,text_area,check_box,select,hidden_field,file_field,date_field,telephone_field,url_field|} :${2:attribute}${3:, class: \"${4}\"} %>"] },
  "form label + field": { "prefix": "flf", "body": ["<%= f.label :${1:attribute} %>", "<%= f.${2|text_field,email_field,password_field,number_field,text_area,check_box,select|} :${1:attribute} %>$0"] },
  "form submit": { "prefix": "fsubmit", "body": ["<%= f.submit \"${1:Save}\"${2:, class: \"${3}\"} %>"] },
  "form select": { "prefix": "fselect", "body": ["<%= f.select :${1:attribute}, ${2:options}, { include_blank: ${3:true} }${4:, class: \"${5}\"} %>"] },
  "collection_select": { "prefix": "fcselect", "body": ["<%= f.collection_select :${1:attribute_id}, ${2:Model}.all, :id, :${3:name}, { include_blank: true } %>"] },
  "fields_for": { "prefix": "fields_for", "body": ["<%= f.fields_for :${1:association} do |${2:ff}| %>", "\t$0", "<% end %>"] },
  "content_for": { "prefix": "content_for", "body": ["<% content_for :${1:name} do %>", "\t$0", "<% end %>"] },
  "yield": { "prefix": "yield", "body": ["<%= yield${1: :${2:name}} %>"] },
  "content_tag": { "prefix": "content_tag", "body": ["<%= content_tag :${1:div}, ${2:content}, class: \"${3}\" %>"] },
  "tag helper": { "prefix": "tag.", "body": ["<%= tag.${1:div}(${2:content}, class: \"${3}\") %>"] },
  "turbo_frame_tag": { "prefix": "turbo_frame", "body": ["<%= turbo_frame_tag ${1:dom_id(@record)} do %>", "\t$0", "<% end %>"] },
  "turbo_stream_from": { "prefix": "turbo_stream", "body": ["<%= turbo_stream_from ${1:@record} %>"] },
  "stimulus controller div": { "prefix": "stimulus", "body": ["<div data-controller=\"${1:name}\"${2: data-${1}-${3:value}-value=\"${4}\"}>", "\t$0", "</div>"] },
  "stimulus action": { "prefix": "data-action", "body": ["data-action=\"${1:click}->${2:controller}#${3:method}\""] },
  "t translation": { "prefix": "t", "body": ["<%= t(\".${1:key}\") %>"] },
  "number_to_currency": { "prefix": "currency", "body": ["<%= number_to_currency(${1:amount}) %>"] },
  "l localize": { "prefix": "l", "body": ["<%= l(${1:date}, format: :${2:long}) %>"] },
  "pluralize": { "prefix": "pluralize", "body": ["<%= pluralize(${1:count}, \"${2:item}\") %>"] },
  "time_ago": { "prefix": "time_ago", "body": ["<%= time_ago_in_words(${1:time}) %> ago"] },
  "flash messages": { "prefix": "flash", "body": ["<% flash.each do |type, message| %>", "\t<div class=\"flash flash-<%= type %>\"><%= message %></div>", "<% end %>"] },
  "errors": { "prefix": "errors", "body": ["<% if ${1:@record}.errors.any? %>", "\t<div class=\"errors\">", "\t\t<ul>", "\t\t\t<% ${1:@record}.errors.full_messages.each do |msg| %>", "\t\t\t\t<li><%= msg %></li>", "\t\t\t<% end %>", "\t\t</ul>", "\t</div>", "<% end %>"] },
  "cache": { "prefix": "cache", "body": ["<% cache ${1:@record} do %>", "\t$0", "<% end %>"] },
  "csrf + csp meta": { "prefix": "meta_tags", "body": ["<%= csrf_meta_tags %>", "<%= csp_meta_tag %>"] },
  "stylesheet + javascript": { "prefix": "assets", "body": ["<%= stylesheet_link_tag \"${1:application}\", \"data-turbo-track\": \"reload\" %>", "<%= javascript_importmap_tags %>"] },
  "layout skeleton": { "prefix": "layout", "body": ["<!DOCTYPE html>", "<html lang=\"${1:en}\">", "\t<head>", "\t\t<meta charset=\"utf-8\">", "\t\t<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">", "\t\t<title><%= content_for(:title) || \"${2:App}\" %></title>", "\t\t<%= csrf_meta_tags %>", "\t\t<%= csp_meta_tag %>", "\t\t<%= stylesheet_link_tag \"application\", \"data-turbo-track\": \"reload\" %>", "\t\t<%= javascript_importmap_tags %>", "\t</head>", "\t<body>", "\t\t<%= yield %>", "\t</body>", "</html>"] },
  "debug": { "prefix": "debug", "body": ["<%= debug(${1:@record}) %>"] }
}
