---
import Listing from "./Listing.astro";
import { backtickParts } from "../lib/backticks.mjs";
import { diagnostics, LANGUAGE_NAMES, type Diagnostic } from "../data/diagnostics";

const listFormat = new Intl.ListFormat("en", { type: "conjunction" });
const languageList = (entry: Diagnostic) => listFormat.format(entry.languages.map((lang) => LANGUAGE_NAMES[lang]));
// Codes sharing the same languages form one section, in the order the data first names them.
const sections = [...Map.groupBy(diagnostics, (entry) => entry.languages.join("-"))].map(([key, entries]) => ({
  id: `in-${key}`,
  title: languageList(entries[0]),
  entries,
}));
const setting = (entry: Diagnostic) =>
  entry.languages.map((lang) => `"rubyTemplates.${lang}.disabledDiagnostics": ["${entry.code}"]`).join(",\n");
---

<div class="roster not-content">
  <nav class="roster__index" aria-labelledby="roster-index-title">
    <h2 class="roster__index-title" id="roster-index-title">All codes</h2>
    <ul class="roster__groups">
      {
        sections.map((section) => (
          <li class="roster__group">
            <a class="roster__group-link" href={`#${section.id}`}>
              {section.title}
            </a>
            <ul class="roster__codes">
              {section.entries.map((entry) => (
                <li>
                  <a class="roster__code-link" href={`#${entry.code}`}>
                    {entry.code}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    sections.map((section) => (
      <section class="roster__section" aria-labelledby={section.id}>
        <h2 class="roster__section-title" id={section.id}>
          {section.title}
        </h2>
        {section.entries.map((entry) => (
          <article class="roster__entry" aria-labelledby={entry.code}>
            <h3 class="roster__code" id={entry.code}>
              <a class="roster__anchor" href={`#${entry.code}`}>
                {entry.code}
              </a>
            </h3>
            <p class="roster__summary">
              {backtickParts(entry.summary).map(({ text, code }) => (code ? <code>{text}</code> : text))}
            </p>
            <dl class="roster__furniture">
              <div class="roster__field">
                <dt class="roster__term">Languages</dt>
                <dd class="roster__detail">{languageList(entry)}</dd>
              </div>
              <div class="roster__field">
                <dt class="roster__term">When it fires</dt>
                <dd class="roster__detail">
                  {backtickParts(entry.explanation).map(({ text, code }) => (code ? <code>{text}</code> : text))}
                </dd>
              </div>
              <div class="roster__field">
                <dt class="roster__term">Example</dt>
                <dd class="roster__detail">
                  <Listing
                    id={entry.code}
                    file={entry.example.file}
                    lang={entry.example.lang}
                    code={entry.example.code}
                    faults={[{ line: entry.line, column: entry.column, message: entry.message, code: entry.code }]}
                  />
                </dd>
              </div>
              <div class="roster__field">
                <dt class="roster__term">Turn it off</dt>
                <dd class="roster__detail">
                  <pre class="roster__setting" tabindex="0" role="region" aria-label="Setting to turn this check off"><code>{setting(entry)}</code></pre>
                </dd>
              </div>
            </dl>
          </article>
        ))}
      </section>
    ))
  }
</div>

<style>
  .roster {
    margin-top: 2.5rem;
    color: var(--rt-ink);
    font-family: var(--rt-font);
  }

  .roster code {
    font-family: var(--rt-font-mono);
    font-size: 0.875em;
  }

  .roster a {
    color: var(--rt-link);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .roster a:hover {
    text-decoration-thickness: 2px;
  }

  /* ---- index: every code at a glance ---- */

  .roster__index {
    padding-block: 1.25rem 1.5rem;
    border-block: 1px solid var(--rt-hairline);
  }

  .roster__index-title {
    margin: 0 0 1rem;
    font-size: 1rem;
    font-weight: 650;
    color: var(--rt-ink-muted);
  }

  .roster__groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roster__group-link {
    font-weight: 650;
  }

  .roster__codes {
    margin: 0.375rem 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--rt-font-mono);
    font-size: 0.875rem;
    line-height: 1.9;
  }

  /* ---- section: the codes one set of languages shares ---- */

  .roster__section {
    margin-top: 3rem;
  }

  .roster__section-title {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 3px double var(--rt-hairline);
    font-size: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    font-weight: 760;
    line-height: 1.15;
    letter-spacing: -0.02em;
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1.5rem);
  }

  /* ---- entry: one code, always the same furniture ---- */

  .roster__entry {
    margin-top: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rt-hairline);
  }

  .roster__section-title + .roster__entry {
    border-top: 0;
    padding-top: 0;
  }

  .roster__code {
    margin: 0;
    font-family: var(--rt-font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1.5rem);
  }

  .roster .roster__anchor {
    color: var(--rt-ink);
    text-decoration: none;
  }

  .roster .roster__anchor:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .roster__summary {
    margin: 0.375rem 0 0;
    font-size: 1.0625rem;
    color: var(--rt-ink);
  }

  .roster__furniture {
    margin: 1.25rem 0 0;
  }

  .roster__field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--rt-hairline);
  }

  @media (min-width: 50rem) {
    .roster__field {
      grid-template-columns: 8rem minmax(0, 1fr);
    }
  }

  .roster__term {
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--rt-ink-muted);
  }

  .roster__detail {
    margin: 0;
    min-width: 0;
    color: var(--rt-ink);
    text-wrap: pretty;
  }

  .roster__setting {
    margin: 0;
    padding: 0.625rem 0.875rem;
    overflow-x: auto;
    background: var(--rt-code-bg);
    border: 1px solid var(--rt-hairline);
    border-radius: 6px;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .roster__setting:focus-visible {
    outline-offset: -2px;
  }
</style>
