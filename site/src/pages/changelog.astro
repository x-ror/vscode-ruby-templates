---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { Content, getHeadings } from "../../../CHANGELOG.md";

// The repository's CHANGELOG.md, so the site and the release notes never disagree.
const headings = getHeadings().filter(({ depth }) => depth > 1);
---

<StarlightPage frontmatter={{ title: "Changelog" }} headings={headings}>
  <Content />
</StarlightPage>
