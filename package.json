{
  "name": "ruby-templates",
  "displayName": "Ruby Templates: ERB, Haml, Slim",
  "description": "Syntax highlighting, diagnostics, go-to-partial, completion and hover, plus snippets, HTML preview, tag toggling and converters for ERB, Haml and Slim templates.",
  "version": "0.1.0",
  "publisher": "x-ror",
  "icon": "images/icon.png",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "ruby",
    "rails",
    "erb",
    "haml",
    "slim",
    "template"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.{jbuilder,builder}"
  ],
  "contributes": {
    "languages": [
      {
        "id": "erb",
        "aliases": [
          "ERB",
          "HTML (ERB)",
          "erb"
        ],
        "extensions": [
          ".erb",
          ".rhtml",
          ".html.erb",
          ".erubi",
          ".erubis"
        ],
        "filenamePatterns": [
          "**/lib/templates/erb/**/*.erb.tt",
          "**/lib/generators/**/templates/**/*.erb.tt"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-js",
        "aliases": [
          "JavaScript (ERB)"
        ],
        "extensions": [
          ".js.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-css",
        "aliases": [
          "CSS (ERB)"
        ],
        "extensions": [
          ".css.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-scss",
        "aliases": [
          "SCSS (ERB)"
        ],
        "extensions": [
          ".scss.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-json",
        "aliases": [
          "JSON (ERB)"
        ],
        "extensions": [
          ".json.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-text",
        "aliases": [
          "Text (ERB)"
        ],
        "extensions": [
          ".text.erb",
          ".txt.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-xml",
        "aliases": [
          "XML (ERB)"
        ],
        "extensions": [
          ".xml.erb",
          ".rss.erb",
          ".atom.erb",
          ".svg.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-markdown",
        "aliases": [
          "Markdown (ERB)"
        ],
        "extensions": [
          ".md.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-ruby",
        "aliases": [
          "Ruby (ERB)"
        ],
        "extensions": [
          ".rb.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-yaml",
        "aliases": [
          "YAML (ERB)"
        ],
        "extensions": [
          ".yml.erb",
          ".yaml.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "haml",
        "aliases": [
          "Haml",
          "haml"
        ],
        "extensions": [
          ".haml",
          ".html.haml"
        ],
        "filenamePatterns": [
          "**/lib/templates/haml/**/*.haml.tt",
          "**/lib/generators/**/templates/**/*.haml.tt"
        ],
        "configuration": "./language-configuration/haml.json"
      },
      {
        "id": "slim",
        "aliases": [
          "Slim",
          "slim"
        ],
        "extensions": [
          ".slim",
          ".html.slim"
        ],
        "filenamePatterns": [
          "**/lib/templates/slim/**/*.slim.tt",
          "**/lib/generators/**/templates/**/*.slim.tt"
        ],
        "configuration": "./language-configuration/slim.json"
      },
      {
        "id": "skim",
        "aliases": [
          "Skim",
          "skim"
        ],
        "extensions": [
          ".skim"
        ],
        "configuration": "./language-configuration/slim.json"
      },
      {
        "id": "ruby",
        "extensions": [
          ".jbuilder",
          ".builder"
        ]
      }
    ],
    "grammars": [
      {
        "language": "erb",
        "scopeName": "text.html.erb",
        "path": "./syntaxes/erb.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby",
          "source.js": "javascript",
          "source.css": "css"
        }
      },
      {
        "language": "erb-js",
        "scopeName": "source.js.erb",
        "path": "./syntaxes/erb-js.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-css",
        "scopeName": "source.css.erb",
        "path": "./syntaxes/erb-css.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-scss",
        "scopeName": "source.css.scss.erb",
        "path": "./syntaxes/erb-scss.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-json",
        "scopeName": "source.json.erb",
        "path": "./syntaxes/erb-json.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-text",
        "scopeName": "text.plain.erb",
        "path": "./syntaxes/erb-text.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-xml",
        "scopeName": "text.xml.erb",
        "path": "./syntaxes/erb-xml.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-markdown",
        "scopeName": "text.html.markdown.erb",
        "path": "./syntaxes/erb-markdown.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-ruby",
        "scopeName": "source.ruby.erb",
        "path": "./syntaxes/erb-ruby.tmLanguage.json"
      },
      {
        "language": "erb-yaml",
        "scopeName": "source.yaml.erb",
        "path": "./syntaxes/erb-yaml.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "haml",
        "scopeName": "text.haml",
        "path": "./syntaxes/haml.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby",
          "source.js": "javascript",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.sass": "sass",
          "source.coffee": "coffeescript",
          "source.css.less": "less",
          "text.html.markdown": "markdown",
          "text.html.erb": "erb"
        }
      },
      {
        "language": "slim",
        "scopeName": "text.slim",
        "path": "./syntaxes/slim.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby",
          "source.js": "javascript",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.sass": "sass",
          "source.coffee": "coffeescript",
          "text.html.markdown": "markdown"
        }
      },
      {
        "language": "skim",
        "scopeName": "text.skim",
        "path": "./syntaxes/skim.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby",
          "source.js": "javascript",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.sass": "sass",
          "source.coffee": "coffeescript",
          "text.html.markdown": "markdown"
        }
      }
    ],
    "snippets": [
      {
        "language": "erb",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-js",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-css",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-scss",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-json",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-text",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-xml",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-markdown",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-ruby",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-yaml",
        "path": "./snippets/erb.json"
      },
      {
        "language": "haml",
        "path": "./snippets/haml.json"
      },
      {
        "language": "slim",
        "path": "./snippets/slim.json"
      }
    ],
    "commands": [
      {
        "command": "rubyTemplates.switchRelated",
        "title": "Ruby Templates: Switch to Related File (other format, component class/template)"
      },
      {
        "command": "rubyTemplates.toggleErbTag",
        "title": "Ruby Templates: Toggle ERB Tag (<% / <%= / <%#)"
      },
      {
        "command": "rubyTemplates.wrapInErb",
        "title": "Ruby Templates: Wrap Selection in ERB Output Tag"
      },
      {
        "command": "rubyTemplates.toggleSlimTag",
        "title": "Ruby Templates: Toggle Slim Line (- / = / == / /)"
      },
      {
        "command": "rubyTemplates.wrapInSlim",
        "title": "Ruby Templates: Wrap Selection in Slim Output (= / #{})"
      },
      {
        "command": "rubyTemplates.extractSlimPartial",
        "title": "Ruby Templates: Extract Selection to Slim Partial"
      },
      {
        "command": "rubyTemplates.preview",
        "title": "Ruby Templates: Preview Rendered HTML"
      },
      {
        "command": "rubyTemplates.convertToHaml",
        "title": "Ruby Templates: Convert ERB/HTML → Haml"
      },
      {
        "command": "rubyTemplates.convertToErb",
        "title": "Ruby Templates: Convert Haml/Slim → ERB"
      },
      {
        "command": "rubyTemplates.extractPartial",
        "title": "Ruby Templates: Extract Selection to Partial"
      },
      {
        "command": "rubyTemplates.toggleHamlPrefix",
        "title": "Ruby Templates: Toggle Haml Line Prefix (- / = / -#)"
      },
      {
        "command": "rubyTemplates.reindentHaml",
        "title": "Ruby Templates: Re-indent Haml (Document or Selection)"
      },
      {
        "command": "rubyTemplates.convertToSlim",
        "title": "Ruby Templates: Convert ERB/Haml → Slim"
      },
      {
        "command": "rubyTemplates.showRenderedSource",
        "title": "Ruby Templates: Show Compiled Ruby Source"
      },
      {
        "command": "rubyTemplates.restartServer",
        "title": "Ruby Templates: Restart Language Server"
      }
    ],
    "keybindings": [
      {
        "command": "rubyTemplates.toggleErbTag",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorLangId =~ /^erb/"
      },
      {
        "command": "rubyTemplates.toggleHamlPrefix",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorLangId == haml"
      },
      {
        "command": "rubyTemplates.toggleSlimTag",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorLangId == slim"
      },
      {
        "command": "rubyTemplates.wrapInErb",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorTextFocus && editorLangId =~ /^erb/"
      },
      {
        "command": "rubyTemplates.wrapInSlim",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorTextFocus && editorLangId == slim"
      },
      {
        "command": "rubyTemplates.preview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && (editorLangId =~ /^erb/ || editorLangId == haml || editorLangId == slim)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rubyTemplates.toggleErbTag",
          "when": "editorLangId =~ /^erb/",
          "group": "rubyTemplates@1"
        },
        {
          "command": "rubyTemplates.wrapInErb",
          "when": "editorLangId =~ /^erb/ && editorHasSelection",
          "group": "rubyTemplates@2"
        },
        {
          "command": "rubyTemplates.toggleSlimTag",
          "when": "editorLangId == slim",
          "group": "rubyTemplates@1"
        },
        {
          "command": "rubyTemplates.wrapInSlim",
          "when": "editorLangId == slim && editorHasSelection",
          "group": "rubyTemplates@2"
        },
        {
          "command": "rubyTemplates.extractSlimPartial",
          "when": "editorLangId == slim && editorHasSelection && resourceScheme == file",
          "group": "rubyTemplates@2"
        },
        {
          "command": "rubyTemplates.preview",
          "when": "editorLangId =~ /^erb/ || editorLangId == haml || editorLangId == slim",
          "group": "rubyTemplates@3"
        },
        {
          "command": "rubyTemplates.toggleHamlPrefix",
          "when": "editorLangId == haml",
          "group": "rubyTemplates@1"
        },
        {
          "command": "rubyTemplates.extractPartial",
          "when": "(editorLangId =~ /^erb/ || editorLangId == haml) && editorHasSelection && resourceScheme == file",
          "group": "rubyTemplates@2"
        },
        {
          "command": "rubyTemplates.convertToHaml",
          "when": "editorLangId == erb || editorLangId == html",
          "group": "rubyTemplates@4"
        },
        {
          "command": "rubyTemplates.convertToSlim",
          "when": "editorLangId == erb || editorLangId == haml",
          "group": "rubyTemplates@5"
        },
        {
          "command": "rubyTemplates.convertToErb",
          "when": "editorLangId == haml || editorLangId == slim",
          "group": "rubyTemplates@5"
        }
      ],
      "commandPalette": [
        {
          "command": "rubyTemplates.switchRelated",
          "when": "resourceScheme == file && (editorLangId =~ /^erb/ || editorLangId =~ /^(haml|slim|skim|ruby)$/)"
        },
        {
          "command": "rubyTemplates.toggleErbTag",
          "when": "editorLangId =~ /^erb/"
        },
        {
          "command": "rubyTemplates.wrapInErb",
          "when": "editorLangId =~ /^erb/"
        },
        {
          "command": "rubyTemplates.toggleSlimTag",
          "when": "editorLangId == slim"
        },
        {
          "command": "rubyTemplates.wrapInSlim",
          "when": "editorLangId == slim"
        },
        {
          "command": "rubyTemplates.extractSlimPartial",
          "when": "editorLangId == slim && editorHasSelection && resourceScheme == file"
        },
        {
          "command": "rubyTemplates.convertToHaml",
          "when": "editorLangId == erb || editorLangId == html"
        },
        {
          "command": "rubyTemplates.convertToSlim",
          "when": "editorLangId == erb || editorLangId == haml"
        },
        {
          "command": "rubyTemplates.convertToErb",
          "when": "editorLangId == haml || editorLangId == slim"
        },
        {
          "command": "rubyTemplates.extractPartial",
          "when": "(editorLangId =~ /^erb/ || editorLangId == haml) && resourceScheme == file"
        },
        {
          "command": "rubyTemplates.toggleHamlPrefix",
          "when": "editorLangId == haml"
        },
        {
          "command": "rubyTemplates.reindentHaml",
          "when": "editorLangId == haml"
        }
      ]
    },
    "configuration": {
      "title": "Ruby Templates",
      "properties": {
        "rubyTemplates.commands.slimrb": {
          "type": "string",
          "default": "slimrb",
          "description": "Executable used to render Slim (gem install slim)."
        },
        "rubyTemplates.slim.compileForRails": {
          "type": "boolean",
          "default": false,
          "description": "Show Compiled Ruby Source for Slim runs `slimrb --rails`: ActionView output buffer and no capture, as Rails compiles it."
        },
        "rubyTemplates.commands.haml": {
          "type": "string",
          "default": "haml",
          "description": "Executable used to render Haml (gem install haml)."
        },
        "rubyTemplates.commands.html2haml": {
          "type": "string",
          "default": "html2haml",
          "description": "Executable for ERB → Haml (gem install html2haml)."
        },
        "rubyTemplates.commands.haml2slim": {
          "type": "string",
          "default": "haml2slim",
          "description": "Executable for Haml → Slim (gem install haml2slim)."
        },
        "rubyTemplates.commands.erb2slim": {
          "type": "string",
          "default": "erb2slim",
          "description": "Executable for ERB → Slim (gem install html2slim)."
        },
        "rubyTemplates.commands.ruby": {
          "type": "string",
          "default": "ruby",
          "description": "Ruby used to preview and compile ERB through Erubi (gem install erubi; stdlib ERB without it) and for Haml → ERB through the haml_to_erb library (gem install haml_to_erb)."
        },
        "rubyTemplates.commands.hamlLint": {
          "type": "string",
          "default": "haml-lint",
          "description": "Executable for Haml lint diagnostics and the haml-lint formatter (gem install haml_lint)."
        },
        "rubyTemplates.hamlLint.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run haml-lint on open and save and show its offenses as diagnostics. Does nothing if haml-lint isn't installed."
        },
        "rubyTemplates.hamlLint.useBundler": {
          "type": "boolean",
          "default": false,
          "description": "Run haml-lint through `bundle exec` when a Gemfile exists in the workspace."
        },
        "rubyTemplates.erb.autoCloseTags": {
          "type": "boolean",
          "default": true,
          "description": "Typing the `>` of an HTML start tag in ERB inserts its end tag after the cursor (like html.autoClosingTags for plain HTML)."
        },
        "rubyTemplates.erb.formatter": {
          "type": "string",
          "enum": [
            "none",
            "builtin",
            "htmlbeautifier",
            "erb-format"
          ],
          "enumDescriptions": [
            "No ERB formatter from this extension (another extension's stays in charge).",
            "Built-in, through the language server: re-indents HTML views by HTML and ERB nesting (<script>/<style> bodies and multi-line tags move as a block) and fixes trailing whitespace, blank lines and the final newline per .editorconfig and .erb_lint.yml; never wraps lines or changes <pre>/<textarea> bodies or Ruby strings. Also Format Selection.",
            "htmlbeautifier (gem install htmlbeautifier): re-indents HTML and ERB blocks to the editor's tab size, keeps line breaks.",
            "erb-format (gem install erb-formatter): re-flows tags and attributes to a line width."
          ],
          "default": "none",
          "description": "What Format Document does in ERB files. Runs through bundle exec when rubyTemplates.preview.useBundler is on."
        },
        "rubyTemplates.commands.htmlbeautifier": {
          "type": "string",
          "default": "htmlbeautifier",
          "description": "Executable for the htmlbeautifier ERB formatter."
        },
        "rubyTemplates.commands.erbFormat": {
          "type": "string",
          "default": "erb-format",
          "description": "Executable for the erb-format ERB formatter (gem install erb-formatter)."
        },
        "rubyTemplates.haml.formatter": {
          "type": "string",
          "enum": [
            "reindent",
            "haml-lint"
          ],
          "enumDescriptions": [
            "Built-in, through the language server: re-indent every nesting level to the file's indent unit and trim trailing whitespace on Haml lines; settings from .editorconfig and .haml-lint.yml. Files with errors other than indentation are left alone.",
            "haml-lint --auto-correct-only: applies the safe corrections of your haml-lint/RuboCop config, which can rewrite Ruby code."
          ],
          "default": "reindent",
          "description": "What Format Document does in Haml files. Format Selection always re-indents."
        },
        "rubyTemplates.preview.refreshOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-render the HTML preview whenever the template is saved."
        },
        "rubyTemplates.preview.useBundler": {
          "type": "boolean",
          "default": false,
          "description": "Prefix render commands with `bundle exec` when a Gemfile exists in the workspace."
        },
        "rubyTemplates.preview.useRails": {
          "type": "boolean",
          "default": false,
          "description": "Render the preview through the app's `bin/rails runner` (`ApplicationController.render(inline:, type:)`) when the file is inside a Rails app, so helpers, routes and partials work. Boots the app on every refresh and gives up after 60 seconds."
        },
        "rubyTemplates.slim.extraEngines": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Embedded engine names registered by your app (e.g. `mjml`) that the unknown-engine check should accept."
        },
        "rubyTemplates.erb.disabledDiagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "unclosed-tag",
              "malformed-tag",
              "stray-end",
              "unmatched-branch",
              "unclosed-block",
              "output-control-flow",
              "silent-output-helper",
              "unterminated-string",
              "ruby-syntax",
              "unexpected-close-tag",
              "mismatched-close-tag",
              "unclosed-element",
              "img-missing-alt",
              "duplicate-id",
              "prefer-image-tag",
              "unsafe-output",
              "unresolved-render",
              "strict-locals"
            ]
          },
          "default": [],
          "uniqueItems": true,
          "description": "Built-in ERB diagnostics to turn off, by code."
        },
        "rubyTemplates.haml.disabledDiagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "inconsistent-indent",
              "bad-dedent",
              "top-level-indent",
              "illegal-nesting",
              "doctype-children",
              "unmatched-branch",
              "explicit-end",
              "illegal-element",
              "unknown-filter",
              "self-closing-content",
              "unclosed-attribute",
              "unresolved-render",
              "strict-locals"
            ]
          },
          "default": [],
          "uniqueItems": true,
          "description": "Built-in Haml diagnostics to turn off, by code."
        },
        "rubyTemplates.jbuilder.disabledDiagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "unresolved-render",
              "strict-locals"
            ]
          },
          "default": [],
          "uniqueItems": true,
          "description": "Built-in diagnostics to turn off in Jbuilder and Builder views, by code."
        },
        "rubyTemplates.slim.disabledDiagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bad-dedent",
              "doctype-children",
              "void-children",
              "unknown-engine",
              "syntax-error",
              "unclosed-attribute",
              "ruby-syntax",
              "explicit-end",
              "unresolved-render",
              "strict-locals"
            ]
          },
          "default": [],
          "uniqueItems": true,
          "description": "Built-in Slim diagnostics to turn off, by code."
        },
        "rubyTemplates.erbLint.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run erb_lint (`--format json --stdin`) on open and save and show its offenses, using the project's .erb_lint.yml. Uses `bundle exec` when rubyTemplates.preview.useBundler is on."
        },
        "rubyTemplates.commands.erbLint": {
          "type": "string",
          "default": "erb_lint",
          "description": "Executable for erb_lint diagnostics (gem install erb_lint)."
        },
        "rubyTemplates.routes.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Read the app's routes with `bin/rails runner` (boots the app once, and again when config/routes.rb or config/routes/*.rb changes) for completion, hover and go to definition of `*_path` / `*_url` helpers in views."
        },
        "rubyTemplates.herbLint.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run herb-lint (`--json`) on ERB files when they are opened and saved and show its offenses, configured by the project's `.herb.yml`. herb-lint reads the file from disk, so unsaved edits are not linted."
        },
        "rubyTemplates.commands.herbLint": {
          "type": "string",
          "default": "herb-lint",
          "description": "Executable for herb-lint diagnostics (npm install --save-dev @herb-tools/linter). With the default, the project's node_modules/.bin/herb-lint wins over one on PATH."
        },
        "rubyTemplates.slimLint.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Run slim-lint (`--reporter json`) on save and show its offenses. Uses `bundle exec` when rubyTemplates.preview.useBundler is on."
        },
        "rubyTemplates.commands.slimLint": {
          "type": "string",
          "default": "slim-lint",
          "description": "Executable used to lint Slim (gem install slim_lint)."
        },
        "rubyTemplates.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the Rust language server (diagnostics, go to partial, completions, hover, and the built-in ERB, Haml and Slim formatting)."
        },
        "rubyTemplates.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ruby-templates-ls binary. Leave empty to use the bundled one."
        }
      }
    },
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "erb": "html",
        "skim": "slim"
      },
      "[haml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      },
      "[slim]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      },
      "[skim]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      },
      "[erb]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "bun build src/extension.js --target=node --format=esm --external vscode --minify-syntax --minify-whitespace --outfile dist/extension.js",
    "package": "bun run build && bunx @vscode/vsce package --no-dependencies",
    "test:tokens": "bun test/tokenize.js",
    "test:snippets": "bun test/snippets.js",
    "test:unit": "bun test/erbTags.js && bun test/langconfig.js && bun test/haml.js && bun test/clientPure.js",
    "test:slim": "bun test/slim.js",
    "test:format": "bun test/slim_format.js",
    "test:vscode": "bun run build && bun test/vscode/run.js",
    "build:server": "cargo build --release --manifest-path server/Cargo.toml && bun server/install-bin.js",
    "test:server": "cargo test --manifest-path server/Cargo.toml && bun server/check-samples.js",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "tm-grammars": "1.32.22",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/x-ror/vscode-ruby-templates"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  }
}
