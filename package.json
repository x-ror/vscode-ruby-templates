{
  "name": "ruby-templates",
  "displayName": "Ruby Templates: ERB, Haml, Slim",
  "description": "Syntax highlighting, snippets, HTML preview, tag toggling and converters for ERB, Haml and Slim templates.",
  "version": "0.1.0",
  "publisher": "x-ror",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "ruby",
    "rails",
    "erb",
    "haml",
    "slim",
    "template"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:erb",
    "onLanguage:haml",
    "onLanguage:slim"
  ],
  "contributes": {
    "languages": [
      {
        "id": "erb",
        "aliases": [
          "ERB",
          "HTML (ERB)",
          "erb"
        ],
        "extensions": [
          ".erb",
          ".rhtml",
          ".html.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-js",
        "aliases": [
          "JavaScript (ERB)"
        ],
        "extensions": [
          ".js.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-css",
        "aliases": [
          "CSS (ERB)"
        ],
        "extensions": [
          ".css.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-scss",
        "aliases": [
          "SCSS (ERB)"
        ],
        "extensions": [
          ".scss.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-json",
        "aliases": [
          "JSON (ERB)"
        ],
        "extensions": [
          ".json.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-text",
        "aliases": [
          "Text (ERB)"
        ],
        "extensions": [
          ".text.erb",
          ".txt.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-xml",
        "aliases": [
          "XML (ERB)"
        ],
        "extensions": [
          ".xml.erb",
          ".rss.erb",
          ".atom.erb",
          ".svg.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-markdown",
        "aliases": [
          "Markdown (ERB)"
        ],
        "extensions": [
          ".md.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-ruby",
        "aliases": [
          "Ruby (ERB)"
        ],
        "extensions": [
          ".rb.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "erb-yaml",
        "aliases": [
          "YAML (ERB)"
        ],
        "extensions": [
          ".yml.erb",
          ".yaml.erb"
        ],
        "configuration": "./language-configuration/erb.json"
      },
      {
        "id": "haml",
        "aliases": [
          "Haml",
          "haml"
        ],
        "extensions": [
          ".haml",
          ".html.haml"
        ],
        "configuration": "./language-configuration/haml.json"
      },
      {
        "id": "slim",
        "aliases": [
          "Slim",
          "slim"
        ],
        "extensions": [
          ".slim",
          ".html.slim",
          ".skim"
        ],
        "configuration": "./language-configuration/slim.json"
      }
    ],
    "grammars": [
      {
        "language": "erb",
        "scopeName": "text.html.erb",
        "path": "./syntaxes/erb.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby",
          "source.js": "javascript",
          "source.css": "css"
        }
      },
      {
        "language": "erb-js",
        "scopeName": "source.js.erb",
        "path": "./syntaxes/erb-js.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-css",
        "scopeName": "source.css.erb",
        "path": "./syntaxes/erb-css.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-scss",
        "scopeName": "source.css.scss.erb",
        "path": "./syntaxes/erb-scss.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-json",
        "scopeName": "source.json.erb",
        "path": "./syntaxes/erb-json.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-text",
        "scopeName": "text.plain.erb",
        "path": "./syntaxes/erb-text.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-xml",
        "scopeName": "text.xml.erb",
        "path": "./syntaxes/erb-xml.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-markdown",
        "scopeName": "text.html.markdown.erb",
        "path": "./syntaxes/erb-markdown.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "erb-ruby",
        "scopeName": "source.ruby.erb",
        "path": "./syntaxes/erb-ruby.tmLanguage.json"
      },
      {
        "language": "erb-yaml",
        "scopeName": "source.yaml.erb",
        "path": "./syntaxes/erb-yaml.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby"
        }
      },
      {
        "language": "haml",
        "scopeName": "text.haml",
        "path": "./syntaxes/haml.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby",
          "source.js": "javascript",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.sass": "sass",
          "source.coffee": "coffeescript",
          "source.css.less": "less",
          "text.html.markdown": "markdown",
          "text.html.erb": "erb"
        }
      },
      {
        "language": "slim",
        "scopeName": "text.slim",
        "path": "./syntaxes/slim.tmLanguage.json",
        "embeddedLanguages": {
          "source.ruby": "ruby",
          "source.js": "javascript",
          "source.css": "css",
          "source.css.scss": "scss",
          "source.sass": "sass",
          "source.coffee": "coffeescript",
          "text.html.markdown": "markdown"
        }
      }
    ],
    "snippets": [
      {
        "language": "erb",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-js",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-css",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-scss",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-json",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-text",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-xml",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-markdown",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-ruby",
        "path": "./snippets/erb.json"
      },
      {
        "language": "erb-yaml",
        "path": "./snippets/erb.json"
      },
      {
        "language": "haml",
        "path": "./snippets/haml.json"
      },
      {
        "language": "slim",
        "path": "./snippets/slim.json"
      }
    ],
    "commands": [
      {
        "command": "rubyTemplates.toggleErbTag",
        "title": "Ruby Templates: Toggle ERB Tag (<% / <%= / <%#)"
      },
      {
        "command": "rubyTemplates.wrapInErb",
        "title": "Ruby Templates: Wrap Selection in ERB Output Tag"
      },
      {
        "command": "rubyTemplates.preview",
        "title": "Ruby Templates: Preview Rendered HTML"
      },
      {
        "command": "rubyTemplates.convertToHaml",
        "title": "Ruby Templates: Convert ERB \u2192 Haml"
      },
      {
        "command": "rubyTemplates.convertToSlim",
        "title": "Ruby Templates: Convert ERB/Haml \u2192 Slim"
      },
      {
        "command": "rubyTemplates.showRenderedSource",
        "title": "Ruby Templates: Show Compiled Ruby Source"
      },
      {
        "command": "rubyTemplates.restartServer",
        "title": "Ruby Templates: Restart Language Server"
      }
    ],
    "keybindings": [
      {
        "command": "rubyTemplates.toggleErbTag",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus && editorLangId =~ /^erb/"
      },
      {
        "command": "rubyTemplates.wrapInErb",
        "key": "ctrl+alt+w",
        "mac": "cmd+alt+w",
        "when": "editorTextFocus && editorLangId =~ /^erb/"
      },
      {
        "command": "rubyTemplates.preview",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && (editorLangId =~ /^erb/ || editorLangId == haml || editorLangId == slim)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "rubyTemplates.toggleErbTag",
          "when": "editorLangId =~ /^erb/",
          "group": "rubyTemplates@1"
        },
        {
          "command": "rubyTemplates.wrapInErb",
          "when": "editorLangId =~ /^erb/ && editorHasSelection",
          "group": "rubyTemplates@2"
        },
        {
          "command": "rubyTemplates.preview",
          "when": "editorLangId =~ /^erb/ || editorLangId == haml || editorLangId == slim",
          "group": "rubyTemplates@3"
        },
        {
          "command": "rubyTemplates.convertToHaml",
          "when": "editorLangId == erb",
          "group": "rubyTemplates@4"
        },
        {
          "command": "rubyTemplates.convertToSlim",
          "when": "editorLangId == erb || editorLangId == haml",
          "group": "rubyTemplates@5"
        }
      ],
      "commandPalette": [
        {
          "command": "rubyTemplates.toggleErbTag",
          "when": "editorLangId =~ /^erb/"
        },
        {
          "command": "rubyTemplates.wrapInErb",
          "when": "editorLangId =~ /^erb/"
        },
        {
          "command": "rubyTemplates.convertToHaml",
          "when": "editorLangId == erb"
        },
        {
          "command": "rubyTemplates.convertToSlim",
          "when": "editorLangId == erb || editorLangId == haml"
        }
      ]
    },
    "configuration": {
      "title": "Ruby Templates",
      "properties": {
        "rubyTemplates.commands.slimrb": {
          "type": "string",
          "default": "slimrb",
          "description": "Executable used to render Slim (gem install slim)."
        },
        "rubyTemplates.commands.haml": {
          "type": "string",
          "default": "haml",
          "description": "Executable used to render Haml (gem install haml)."
        },
        "rubyTemplates.commands.erb": {
          "type": "string",
          "default": "erb",
          "description": "Executable used to render ERB (ships with Ruby)."
        },
        "rubyTemplates.commands.html2haml": {
          "type": "string",
          "default": "html2haml",
          "description": "Executable for ERB \u2192 Haml (gem install html2haml)."
        },
        "rubyTemplates.commands.haml2slim": {
          "type": "string",
          "default": "haml2slim",
          "description": "Executable for Haml \u2192 Slim (gem install haml2slim)."
        },
        "rubyTemplates.commands.erb2slim": {
          "type": "string",
          "default": "erb2slim",
          "description": "Executable for ERB \u2192 Slim (gem install html2slim)."
        },
        "rubyTemplates.preview.refreshOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-render the HTML preview whenever the template is saved."
        },
        "rubyTemplates.preview.useBundler": {
          "type": "boolean",
          "default": false,
          "description": "Prefix render commands with `bundle exec` when a Gemfile exists in the workspace."
        },
        "rubyTemplates.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the Rust language server (diagnostics, go to partial, completions, hover)."
        },
        "rubyTemplates.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the ruby-templates-ls binary. Leave empty to use the bundled one."
        }
      }
    },
    "configurationDefaults": {
      "emmet.includeLanguages": {
        "erb": "html"
      },
      "[haml]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      },
      "[slim]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      },
      "[erb]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    }
  },
  "scripts": {
    "package": "npx @vscode/vsce package",
    "test:tokens": "node test/tokenize.js",
    "test:snippets": "node test/snippets.js",
    "build:server": "cargo build --release --manifest-path server/Cargo.toml && mkdir -p bin/$(node -p \"process.platform+'-'+process.arch\") && cp server/target/release/ruby-templates-ls bin/$(node -p \"process.platform+'-'+process.arch\")/",
    "test:server": "cargo test --manifest-path server/Cargo.toml && server/target/release/ruby-templates-ls --check test/sample.*"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/x-ror/vscode-ruby-templates"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
