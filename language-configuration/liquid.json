{
  "comments": { "blockComment": ["{% comment %}", "{% endcomment %}"] },
  "brackets": [
    ["{{", "}}"],
    ["{%", "%}"],
    ["<", ">"],
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{{", "close": " }}" },
    { "open": "{%", "close": " %}" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "<!--", "close": " -->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["<", ">"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#region\\b.*-->|^\\s*\\{%-?\\s*comment\\b",
      "end": "^\\s*<!--\\s*#endregion\\b.*-->|^\\s*\\{%-?\\s*endcomment\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "\\{%-?\\s*(if|unless|case|for|capture|tablerow|form|paginate|else|elsif|when|comment|raw)\\b(?!.*\\{%-?\\s*end\\w+)|<(?!area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr|\\?|!|/)([-_.A-Za-z0-9]+)(?=\\s|>)\\b[^>]*>(?!.*</\\2>)",
    "decreaseIndentPattern": "^\\s*(\\{%-?\\s*(end\\w+|else|elsif|when)\\b|</[-_.A-Za-z0-9]+\\s*>)"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([A-Za-z_][\\w-]*)"
}
