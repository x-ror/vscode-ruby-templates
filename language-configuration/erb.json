{
  "comments": { "blockComment": ["<%#", "%>"] },
  "brackets": [["<%", "%>"], ["<", ">"], ["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "<%", "close": " %>" },
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "<!--", "close": " -->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"], ["<", ">"]],
  "folding": {
    "markers": {
      "start": "^\\s*<!--\\s*#region\\b.*-->|^\\s*<%#\\s*region\\b",
      "end": "^\\s*<!--\\s*#endregion\\b.*-->|^\\s*<%#\\s*endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "<%[-=]?\\s*(if|unless|while|until|for|case|begin|do|def|class|module|else|elsif|when|rescue|ensure)\\b(?!.*\\bend\\b\\s*[-=]?%>)|(<%(?!#)[-=]?[^%]*\\bdo\\b(?:\\s*\\|[^|]*\\|)?\\s*[-=]?%>)|<(?!area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr|\\?|!|/)([-_.A-Za-z0-9]+)(?=\\s|>)\\b[^>]*>(?!.*</\\3>)",
    "decreaseIndentPattern": "^\\s*(<%-?\\s*(end|else|elsif|when|rescue|ensure)\\b.*%>|</[-_.A-Za-z0-9]+\\s*>)"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([A-Za-z_@$][\\w-]*[?!]?)",
  "onEnterRules": [
    {
      "beforeText": "<%[-=#]{0,2}\\s*$",
      "afterText": "^\\s*[-=]?%>",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "<%[-=]{0,2}\\s*(if|unless|while|until|for|case|begin|def|class|module|else|elsif|when|rescue|ensure)\\b(?!.*\\bend\\b).*%>\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "<%(?!#)[-=]{0,2}(?:[^%]|%(?!>))*\\bdo\\b(?:\\s*\\|[^|]*\\|)?\\s*[-=]?%>\\s*$",
      "action": { "indent": "indent" }
    }
  ]
}
