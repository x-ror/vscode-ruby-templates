{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XML (ERB)",
  "scopeName": "text.xml.erb",
  "injections": {
    "L:text.xml.erb - (meta.embedded.block.erb | meta.embedded.line.erb | comment.block.erb)": {
      "patterns": [
        {
          "include": "text.html.erb#erb"
        }
      ]
    }
  },
  "patterns": [
    {
      "include": "text.html.erb#erb"
    },
    {
      "include": "text.xml"
    }
  ]
}
