{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HTML (Liquid)",
  "scopeName": "text.html.liquid",
  "fileTypes": ["liquid", "html.liquid"],
  "injections": {
    "L:text.html.liquid - (meta.embedded.block.liquid | meta.embedded.line.liquid | meta.raw.liquid | comment.block.liquid)": {
      "patterns": [
        {
          "include": "#liquid"
        }
      ]
    }
  },
  "patterns": [
    {
      "include": "#liquid"
    },
    {
      "include": "text.html.basic"
    }
  ],
  "repository": {
    "liquid": {
      "patterns": [
        {
          "include": "#raw"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#inline-comment"
        },
        {
          "include": "#liquid-tag"
        },
        {
          "include": "#output"
        },
        {
          "include": "#tag"
        }
      ]
    },
    "raw": {
      "name": "meta.raw.liquid",
      "begin": "({%-?)\\s*(raw)\\s*(-?%})",
      "end": "({%-?)\\s*(endraw)\\s*(-?%})",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.liquid"
        },
        "2": {
          "name": "keyword.control.liquid"
        },
        "3": {
          "name": "punctuation.section.embedded.end.liquid"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.liquid"
        },
        "2": {
          "name": "keyword.control.liquid"
        },
        "3": {
          "name": "punctuation.section.embedded.end.liquid"
        }
      }
    },
    "comment": {
      "name": "comment.block.liquid",
      "begin": "{%-?\\s*comment\\s*-?%}",
      "end": "{%-?\\s*endcomment\\s*-?%}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.liquid"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.liquid"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        }
      ]
    },
    "inline-comment": {
      "name": "comment.block.liquid",
      "begin": "{%-?\\s*#",
      "end": "-?%}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.liquid"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.liquid"
        }
      }
    },
    "output": {
      "name": "meta.embedded.line.liquid",
      "begin": "{{-?",
      "end": "-?}}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.liquid"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.liquid"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "tag": {
      "name": "meta.embedded.block.liquid",
      "begin": "{%-?",
      "end": "-?%}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.liquid"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.liquid"
        }
      },
      "patterns": [
        {
          "include": "#tag-name"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "liquid-tag": {
      "name": "meta.embedded.block.liquid",
      "begin": "({%-?)\\s*(liquid)\\b",
      "end": "-?%}",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.begin.liquid"
        },
        "2": {
          "name": "keyword.control.liquid"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.liquid"
        }
      },
      "patterns": [
        {
          "name": "comment.line.number-sign.liquid",
          "match": "^\\s*#.*?(?=-?%}|$)"
        },
        {
          "include": "#line-tag-name"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "tag-name": {
      "match": "\\G\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#tag-keyword"
            }
          ]
        }
      }
    },
    "line-tag-name": {
      "match": "(?:^|\\G)\\s*([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "patterns": [
            {
              "include": "#tag-keyword"
            }
          ]
        }
      }
    },
    "tag-keyword": {
      "patterns": [
        {
          "name": "keyword.control.liquid",
          "match": "\\b(?:if|elsif|else|endif|unless|endunless|case|when|endcase|for|endfor|break|continue|cycle|tablerow|endtablerow|paginate|endpaginate|capture|endcapture|form|endform|style|endstyle|javascript|endjavascript|schema|endschema|stylesheet|endstylesheet|ifchanged|endifchanged)\\b"
        },
        {
          "name": "support.function.tag.liquid",
          "match": "\\w+"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#filter"
        },
        {
          "include": "#named-argument"
        },
        {
          "include": "#constant"
        },
        {
          "include": "#operator"
        },
        {
          "include": "#number"
        },
        {
          "include": "#range"
        },
        {
          "include": "#property"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.liquid",
          "begin": "\"",
          "end": "\"|(?=-?%}|-?}})",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.liquid"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.liquid"
            }
          }
        },
        {
          "name": "string.quoted.single.liquid",
          "begin": "'",
          "end": "'|(?=-?%}|-?}})",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.liquid"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.liquid"
            }
          }
        }
      ]
    },
    "filter": {
      "match": "(\\|)\\s*([A-Za-z_]\\w*)(?:\\s*(:))?",
      "captures": {
        "1": {
          "name": "punctuation.separator.filter.liquid"
        },
        "2": {
          "name": "support.function.filter.liquid"
        },
        "3": {
          "name": "punctuation.separator.key-value.liquid"
        }
      }
    },
    "named-argument": {
      "match": "([A-Za-z_](?:[\\w-]*\\w)?)\\s*(:)",
      "captures": {
        "1": {
          "name": "variable.parameter.liquid"
        },
        "2": {
          "name": "punctuation.separator.key-value.liquid"
        }
      }
    },
    "constant": {
      "name": "constant.language.liquid",
      "match": "\\b(?:true|false|nil|null|empty|blank)\\b"
    },
    "operator": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.liquid",
          "match": "==|!=|<>|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.liquid",
          "match": "\\b(?:contains|and|or|in)\\b"
        },
        {
          "name": "keyword.operator.assignment.liquid",
          "match": "="
        }
      ]
    },
    "number": {
      "name": "constant.numeric.liquid",
      "match": "-?\\b\\d+(?:\\.\\d+)?\\b"
    },
    "range": {
      "match": "(\\()\\s*([^()]*?)\\s*(\\.\\.)\\s*([^()]*?)\\s*(\\))",
      "captures": {
        "1": {
          "name": "punctuation.definition.range.begin.liquid"
        },
        "2": {
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        "3": {
          "name": "keyword.operator.range.liquid"
        },
        "4": {
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        "5": {
          "name": "punctuation.definition.range.end.liquid"
        }
      }
    },
    "property": {
      "match": "(?<=\\.)[A-Za-z_](?:[\\w-]*\\w)?",
      "name": "variable.other.property.liquid"
    },
    "variable": {
      "name": "variable.other.liquid",
      "match": "[A-Za-z_](?:[\\w-]*\\w)?"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.liquid",
          "match": ","
        },
        {
          "name": "punctuation.accessor.liquid",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.bracket.liquid",
          "match": "[\\[\\]()]"
        }
      ]
    }
  }
}
