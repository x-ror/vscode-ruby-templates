{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Haml",
  "scopeName": "text.haml",
  "fileTypes": ["haml", "html.haml"],
  "injections": {
    "L:meta.filter.haml - (source.ruby | text.html.erb)": {
      "patterns": [
        {
          "include": "#escape"
        },
        {
          "include": "#interpolation"
        }
      ]
    }
  },
  "patterns": [
    {
      "include": "#doctype"
    },
    {
      "include": "#strict-locals"
    },
    {
      "include": "#silent-comment"
    },
    {
      "include": "#html-comment"
    },
    {
      "include": "#filters"
    },
    {
      "include": "#tag-line"
    },
    {
      "include": "#ruby-line"
    },
    {
      "include": "#plain-line"
    }
  ],
  "repository": {
    "doctype": {
      "name": "meta.prolog.haml",
      "match": "^\\s*(!!!)(?:\\s+(\\S.*))?$",
      "captures": {
        "1": {
          "name": "punctuation.definition.prolog.haml"
        },
        "2": {
          "name": "entity.name.tag.doctype.haml"
        }
      }
    },
    "strict-locals": {
      "name": "meta.strict-locals.haml",
      "match": "^\\s*(-#)\\s+(locals:)\\s+(\\()(.*)(\\))\\s*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.haml"
        },
        "2": {
          "name": "keyword.other.strict-locals.haml"
        },
        "3": {
          "name": "punctuation.definition.parameters.begin.haml"
        },
        "4": {
          "name": "meta.function.parameters.haml source.ruby",
          "patterns": [
            {
              "include": "source.ruby"
            }
          ]
        },
        "5": {
          "name": "punctuation.definition.parameters.end.haml"
        }
      }
    },
    "silent-comment": {
      "name": "comment.block.haml",
      "begin": "^(\\s*)(-#)(.*)$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.comment.haml"
        },
        "3": {
          "name": "comment.line.haml"
        }
      },
      "end": "^(?!\\1\\s)(?=\\s*\\S)"
    },
    "html-comment": {
      "name": "comment.block.html.haml",
      "begin": "^(\\s*)(/)(\\[[^\\]]*\\])?(.*)$",
      "beginCaptures": {
        "2": {
          "name": "punctuation.definition.comment.haml"
        },
        "3": {
          "name": "keyword.other.conditional-comment.haml"
        },
        "4": {
          "name": "comment.block.html"
        }
      },
      "end": "^(?!\\1\\s)(?=\\s*\\S)",
      "patterns": [
        {
          "include": "#tag-line"
        },
        {
          "include": "#plain-line"
        }
      ]
    },
    "filters": {
      "patterns": [
        {
          "name": "meta.filter.haml",
          "contentName": "source.js",
          "begin": "^(\\s*)(:)(javascript)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "source.css",
          "begin": "^(\\s*)(:)(css)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "source.css"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "source.css.less",
          "begin": "^(\\s*)(:)(less)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "source.css.less"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "source.ruby",
          "begin": "^(\\s*)(:)(ruby)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "source.ruby"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "source.css.scss",
          "begin": "^(\\s*)(:)(scss)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "source.css.scss"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "source.sass",
          "begin": "^(\\s*)(:)(sass)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "source.sass"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "source.coffee",
          "begin": "^(\\s*)(:)(coffee|coffeescript)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "source.coffee"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "text.html.markdown",
          "begin": "^(\\s*)(:)(markdown)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "text.html.markdown"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "text.html.erb",
          "begin": "^(\\s*)(:)(erb)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)",
          "patterns": [
            {
              "include": "text.html.erb"
            }
          ]
        },
        {
          "name": "meta.filter.haml",
          "contentName": "string.unquoted.haml",
          "begin": "^(\\s*)(:)(plain|preserve|escaped|cdata)\\s*$",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.filter.haml"
            },
            "3": {
              "name": "entity.name.function.filter.haml"
            }
          },
          "end": "^(?!\\1\\s)(?=\\s*\\S)"
        }
      ]
    },
    "tag-line": {
      "patterns": [
        {
          "name": "meta.tag.haml",
          "begin": "^(?!.*\\bdo\\s*\\|[^|]*\\s\\|[ \\t]*$)\\s*(?=(?:%[\\w:-]+|[.#][\\w-]).*\\s\\|[ \\t]*$)",
          "end": "^(?!.*\\s\\|[ \\t]*$)",
          "patterns": [
            {
              "include": "#tag-head"
            },
            {
              "include": "#inline-ruby-multiline"
            },
            {
              "include": "#inline-text-multiline"
            }
          ]
        },
        {
          "name": "meta.tag.haml",
          "begin": "^\\s*(?=%[\\w:-]+|[.#][\\w-])",
          "end": "$",
          "patterns": [
            {
              "include": "#tag-head"
            },
            {
              "include": "#inline-ruby"
            },
            {
              "include": "#inline-text"
            }
          ]
        }
      ]
    },
    "tag-head": {
      "patterns": [
        {
          "name": "entity.name.tag.haml",
          "match": "(%)([\\w:-]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.haml"
            }
          }
        },
        {
          "name": "entity.other.attribute-name.class.haml",
          "match": "(\\.)([\\w-]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.entity.haml"
            }
          }
        },
        {
          "name": "entity.other.attribute-name.id.haml",
          "match": "(#)([\\w-]+)",
          "captures": {
            "1": {
              "name": "punctuation.definition.entity.haml"
            }
          }
        },
        {
          "include": "#hash-attributes"
        },
        {
          "include": "#html-attributes"
        },
        {
          "include": "#object-ref"
        },
        {
          "name": "keyword.operator.whitespace.haml",
          "match": "[<>]+"
        },
        {
          "name": "punctuation.definition.tag.self-closing.haml",
          "match": "/"
        }
      ]
    },
    "hash-attributes": {
      "name": "meta.attributes.hash.haml",
      "contentName": "source.ruby",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.attributes.begin.haml"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.attributes.end.haml"
        }
      },
      "patterns": [
        {
          "include": "#ruby-braces"
        },
        {
          "include": "source.ruby"
        }
      ]
    },
    "html-attributes": {
      "name": "meta.attributes.html.haml",
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.attributes.begin.haml"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.attributes.end.haml"
        }
      },
      "patterns": [
        {
          "name": "entity.other.attribute-name.html.haml",
          "match": "(?<![=\\w:@-])[\\w:@-]+"
        },
        {
          "name": "keyword.operator.assignment.haml",
          "match": "="
        },
        {
          "include": "#string-double"
        },
        {
          "include": "#string-single"
        },
        {
          "name": "source.ruby",
          "begin": "(?<==)(?=[^\\s\"'\\)])",
          "end": "(?=[\\s\\)])",
          "patterns": [
            {
              "begin": "\\(",
              "end": "\\)",
              "patterns": [
                {
                  "include": "source.ruby"
                }
              ]
            },
            {
              "begin": "\\[",
              "end": "\\]",
              "patterns": [
                {
                  "include": "source.ruby"
                }
              ]
            },
            {
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#ruby-braces"
                },
                {
                  "include": "source.ruby"
                }
              ]
            },
            {
              "include": "source.ruby"
            }
          ]
        }
      ]
    },
    "object-ref": {
      "name": "meta.attributes.object-reference.haml",
      "contentName": "source.ruby",
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.attributes.begin.haml"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.attributes.end.haml"
        }
      },
      "patterns": [
        {
          "include": "source.ruby"
        }
      ]
    },
    "inline-ruby": {
      "name": "meta.embedded.line.ruby.haml",
      "contentName": "source.ruby",
      "begin": "\\s*([&!]?[=~])(?!=)\\s*",
      "end": "(?<![, \\t]|[, \\t]\\n)[ \\t]*$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.ruby.haml"
        }
      },
      "patterns": [
        {
          "include": "source.ruby"
        }
      ]
    },
    "inline-ruby-multiline": {
      "name": "meta.embedded.line.ruby.haml",
      "contentName": "source.ruby",
      "begin": "\\s*([&!]?[=~])(?!=)\\s*",
      "end": "^(?!.*\\s\\|[ \\t]*$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.embedded.ruby.haml"
        }
      },
      "patterns": [
        {
          "include": "#multiline-pipe"
        },
        {
          "include": "source.ruby"
        }
      ]
    },
    "inline-text": {
      "name": "string.unquoted.text.haml",
      "begin": "(?:\\s*([&!]?==|[&!])\\s*|\\s+)(?=\\S)",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.text.haml"
        }
      },
      "patterns": [
        {
          "include": "#text"
        }
      ]
    },
    "inline-text-multiline": {
      "name": "string.unquoted.text.haml",
      "begin": "(?:\\s*([&!]?==|[&!])\\s*|\\s+)(?=\\S)",
      "end": "^(?!.*\\s\\|[ \\t]*$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.text.haml"
        }
      },
      "patterns": [
        {
          "include": "#multiline-pipe"
        },
        {
          "include": "#text"
        }
      ]
    },
    "ruby-line": {
      "patterns": [
        {
          "name": "meta.line.ruby.haml",
          "contentName": "source.ruby",
          "begin": "^(?!.*\\bdo\\s*\\|[^|]*\\s\\|[ \\t]*$)\\s*(-|[&!]?[=~])(?!=)\\s*(?=.*\\s\\|[ \\t]*$)",
          "end": "^(?!.*\\s\\|[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.embedded.ruby.haml"
            }
          },
          "patterns": [
            {
              "include": "#multiline-pipe"
            },
            {
              "include": "source.ruby"
            }
          ]
        },
        {
          "name": "meta.line.ruby.haml",
          "contentName": "source.ruby",
          "begin": "^\\s*(-|[&!]?[=~])(?!=)\\s*",
          "end": "(?<![, \\t]|[, \\t]\\n)[ \\t]*$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.section.embedded.ruby.haml"
            }
          },
          "patterns": [
            {
              "name": "keyword.control.haml",
              "match": "\\b(end|else|elsif|when|rescue|ensure)\\b(?=\\s*$)"
            },
            {
              "include": "source.ruby"
            }
          ]
        }
      ]
    },
    "plain-line": {
      "patterns": [
        {
          "name": "string.unquoted.text.haml",
          "begin": "^(?!.*\\bdo\\s*\\|[^|]*\\s\\|[ \\t]*$)\\s*(?:([&!]?==|[&!](?=\\s|#\\{))\\s*|(\\\\))?(?=\\S)(?=.*\\s\\|[ \\t]*$)",
          "end": "^(?!.*\\s\\|[ \\t]*$)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.text.haml"
            },
            "2": {
              "name": "constant.character.escape.haml"
            }
          },
          "patterns": [
            {
              "include": "#multiline-pipe"
            },
            {
              "include": "#text"
            }
          ]
        },
        {
          "name": "string.unquoted.text.haml",
          "begin": "^\\s*(?:([&!]?==|[&!](?=\\s|#\\{))\\s*|(\\\\))?(?=\\S)",
          "end": "$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.text.haml"
            },
            "2": {
              "name": "constant.character.escape.haml"
            }
          },
          "patterns": [
            {
              "include": "#text"
            }
          ]
        }
      ]
    },
    "text": {
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "#escape"
        }
      ]
    },
    "multiline-pipe": {
      "name": "punctuation.separator.continuation.multiline.haml",
      "match": "(?<=\\s)\\|(?=[ \\t]*$)"
    },
    "interpolation": {
      "name": "meta.embedded.interpolation.haml",
      "contentName": "source.ruby",
      "begin": "(?<!\\\\)#\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.haml"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.haml"
        }
      },
      "patterns": [
        {
          "include": "#ruby-braces"
        },
        {
          "include": "source.ruby"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.haml",
      "match": "\\\\#\\{"
    },
    "string-double": {
      "name": "string.quoted.double.haml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "name": "constant.character.escape.haml",
          "match": "\\\\."
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.haml",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.haml",
          "match": "\\\\."
        }
      ]
    },
    "ruby-braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.scope.begin.ruby"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.scope.end.ruby"
        }
      },
      "patterns": [
        {
          "include": "#ruby-braces"
        },
        {
          "include": "source.ruby"
        }
      ]
    }
  }
}
