#!/bin/sh
# Formats staged JS (Prettier) and Rust (rustfmt) files and re-stages them.
set -e

js=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.js' 'test/*.js')
rs=$(git diff --cached --name-only --diff-filter=ACMR -- 'server/*.rs')
[ -z "$js$rs" ] && exit 0

# Re-staging a partly staged file would also commit its unstaged changes.
partial=$(git diff --name-only -- $js $rs)
if [ -n "$partial" ]; then
  echo "pre-commit: these files have unstaged changes, stage or stash them first:" >&2
  echo "$partial" >&2
  exit 1
fi

[ -n "$js" ] && npx --no-install prettier --write $js >/dev/null
[ -n "$rs" ] && rustfmt --edition 2021 $rs
git add $js $rs
